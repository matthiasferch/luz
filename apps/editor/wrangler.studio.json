{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luz-studio",
  "main": "tooling/studio-worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "ACCESS_ISSUER": "https://silent-fog-8a52.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "6ca2168b14c6200ab9195ebf9b78898fa7c01bf50665965a49523b85d99efa86"
  },
  "assets": {
    "directory": "./dist/studio",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "d1_databases": [
    { "binding": "DATABASE", "database_name": "luz-studio", "database_id": "9671a6d8-ba61-42ac-9668-119cf7e87b23" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "luz-studio-files" }],
  "routes": [{ "pattern": "studio.luzjs.dev", "custom_domain": true }]
}
