{
  "name": "@luz/editor",
  "license": "MIT",
  "version": "0.3.0",
  "author": "Matthias Ferch",
  "scripts": {
    "test": "npm run test:engine && npm run test:ui",
    "test:engine": "node --require ../../tooling/register-assets.cjs --test tests/*.test.cjs",
    "test:ui": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests tooling types webpack.config.js vitest.config.mts .eslintrc.cjs --ext .ts,.mts,.cts,.vue,.js,.cjs,.mjs --max-warnings 0",
    "build": "rimraf ./dist && webpack",
    "build:demo": "node tooling/build-demo.cjs",
    "preview:demo": "node tooling/serve-demo.cjs",
    "watch": "webpack --watch",
    "serve": "webpack serve --open"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "ajv": "^6.12.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.3",
    "json-loader": "^0.5.7",
    "spectorjs": "^0.9.30",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.11",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@luz/browser": "*",
    "@luz/core": "*",
    "@luz/formats": "*",
    "@luz/graphics": "*",
    "@luz/math": "*",
    "@luz/physics": "*",
    "@luz/scene": "*",
    "@luz/serialization": "*",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.42"
  }
}
