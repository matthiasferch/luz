{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reflector.schema.json",
  "title": "Reflector",
  "type": "object",
  "properties": {
    "type": { "const": "reflector" },
    "normal": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "offset": { "type": "number" },
    "resolutionScale": { "type": "number", "minimum": 0.1, "maximum": 1 },
    "clipBias": { "type": "number", "minimum": 0 },
    "intensity": { "type": "number", "minimum": 0 },
    "maximumRoughness": { "type": "number", "minimum": 0.04, "maximum": 1 },
    "meshes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["type"],
  "additionalProperties": false
}
