{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "polygon.schema.json",
  "title": "Polygon",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "polygon"
    },
    "vertices": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "default": []
    },
    "collisionGroup": {
      "type": "integer",
      "default": 1
    },
    "collisionMask": {
      "type": "integer",
      "default": 4294967295
    }
  },
  "required": ["type", "vertices"],
  "additionalProperties": false
}
