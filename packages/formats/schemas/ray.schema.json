{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ray.schema.json",
  "title": "Ray",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "ray"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 0, 0]
    },
    "direction": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 1, 0]
    },
    "collisionGroup": {
      "type": "integer",
      "default": 1
    },
    "collisionMask": {
      "type": "integer",
      "default": 4294967295
    }
  },
  "required": ["type", "origin", "direction"],
  "additionalProperties": false
}
