{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plane.schema.json",
  "title": "Plane",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "plane"
    },
    "normal": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 1, 0]
    },
    "distance": {
      "type": "number",
      "default": 0
    },
    "collisionGroup": {
      "type": "integer",
      "default": 1
    },
    "collisionMask": {
      "type": "integer",
      "default": 4294967295
    }
  },
  "required": ["type", "normal", "distance"],
  "additionalProperties": false
}
