{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "animation.schema.json",
  "title": "Animation",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schemaVersion", "duration", "tracks", "playback", "isAutoplayEnabled"],
  "properties": {
    "type": {
      "const": "animation"
    },
    "playback": {
      "type": "string",
      "enum": ["loop", "once"],
      "default": "once"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "translation": {
          "$ref": "#/definitions/vector3Track"
        },
        "rotation": {
          "$ref": "#/definitions/quaternionTrack"
        },
        "scale": {
          "$ref": "#/definitions/vector3Track"
        }
      }
    },
    "schemaVersion": {
      "const": 2
    },
    "isAutoplayEnabled": {
      "type": "boolean",
      "default": false
    }
  },
  "definitions": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "vector3Track": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "value"],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "value": {
            "$ref": "#/definitions/vector3"
          }
        }
      }
    },
    "quaternionTrack": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "value"],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "value": {
            "$ref": "#/definitions/quaternion"
          }
        }
      }
    }
  }
}
