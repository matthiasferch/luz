{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity.schema.json",
  "title": "Entity",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "body.schema.json"
          },
          {
            "$ref": "biped.schema.json"
          },
          {
            "$ref": "light.schema.json"
          },
          {
            "$ref": "model.schema.json"
          },
          {
            "$ref": "camera.schema.json"
          },
          {
            "$ref": "reflector.schema.json"
          },
          {
            "$ref": "animation.schema.json"
          },
          {
            "type": "string"
          }
        ]
      },
      "default": {}
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [1, 1, 1]
    },
    "rotation": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "default": [0, 0, 0, 1]
    },
    "translation": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 0, 0]
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "children": {
      "type": "object",
      "additionalProperties": {
        "$ref": "entity.schema.json"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["entity"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["components"]
            },
            {
              "required": ["children"]
            }
          ]
        }
      }
    }
  ]
}
